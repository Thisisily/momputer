{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "momputer",
  "version": "0.1.0",
  "identifier": "dev.momputer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "momputer",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 440,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "momputer contributors",
    "category": "Utility",
    "shortDescription": "A mom for your AI",
    "longDescription": "Shows every runtime your AI agents left running, who started it, and cleans up after them.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mom"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
